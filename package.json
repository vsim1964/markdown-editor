{
  "name": "markdown-editor",
  "version": "0.1.4",
  "description": "Local visual Markdown editor",
  "author": "Markdown Editor contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@toast-ui/editor": "3.2.2",
    "prismjs": "1.30.0",
    "marked": "15.0.12",
    "@toast-ui/editor-plugin-code-syntax-highlight": "3.1.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "org.markdowneditor.desktop",
    "productName": "Markdown Editor",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}